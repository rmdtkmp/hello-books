---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "I am a passionate book reader who believes stories and knowledge should not remain confined to the pages. My hobby has grown into a journey of making summaries, extracting insights, and sharing reflections that spark curiosity and deeper understanding.",
	title: "about:hello-books",
};
---

<PageLayout meta={meta}>
	<h2 class="title mb-12">about:hello-books</h2>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			I am a passionate book reader who believes stories and knowledge should not remain confined to the pages. My hobby has grown into a journey of making summaries, extracting insights, and sharing reflections that spark curiosity and deeper understanding.
		</p>
		<p>
			To bring these experiences to a wider audience, I am developing a Progressive Web App (PWA) — a platform where reading meets technology. Through it, I aim to broadcast ideas, lessons, and perspectives from books to readers worldwide, creating a space where knowledge flows freely and inspires growth.
		</p>
		<p>
			This project is not just about reading; it’s about connecting, learning, and building a community of thinkers who value the power of words.
		</p>
		<h3>Credits</h3>
		<p>
			Built with ❤️ using Github, Astro, and <a
				class="cactus-link inline-block"
				href="https://github.com/chrismwilliams/astro-cactus"
				rel="noreferrer"
				target="_blank">Cactus</a>.
			<br>
			<br>
			Theme repository: https://github.com/chrismwilliams/astro-cactus
		</p>
		<p>
			Cheers ^^
		</p>
	</div>
</PageLayout>